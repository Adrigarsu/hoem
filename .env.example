# Copy to .env.local and fill in.
# Locally, `pnpm db:start` prints the Supabase URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Locally any value starting with re_ works: Supabase Auth e-mails go to Mailpit
# (http://127.0.0.1:54324), not Resend.
RESEND_API_KEY=
